# CodeLive environment contract (D-24).
# This file lists the five variable names with local-development placeholders only.
# Real values never get committed. Generate your own SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql+psycopg://codelive:codelive@localhost:5432/codelive
TEST_DATABASE_URL=postgresql+psycopg://codelive:codelive@localhost:5432/codelive_test
SESSION_SECRET=generate-with-python-secrets-token-urlsafe
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO